# Copia il file in .env accanto a docker-compose.yml.
GUIDATV_BIND=127.0.0.1
GUIDATV_PORT=8085

# Per LAN e Tailscale, lascia GUIDATV_BIND vuoto per ascoltare su tutte le interfacce.
# Playlist M3U ufficiale inclusa. Puoi usare un URL o un file sotto /streams.
GUIDATV_STREAMS_M3U=/streams/official.m3u

# Imposta la condivisione per abilitare le registrazioni. Esempio: //nas.local/TV
GUIDATV_SMB_SHARE=
GUIDATV_SMB_IP=
GUIDATV_SMB_TAILSCALE_HOST=
# GUIDATV_SMB_DIR=/percorso/che/contiene/smb.credentials
RECORDINGS_BEFORE_MIN=2
RECORDINGS_AFTER_MIN=10
RECORDINGS_MAX_CONCURRENT=2
# Sorgenti sperimentali per registrare dai flussi dei player ufficiali.
RECORDINGS_TV8=0
RECORDINGS_RAI=0
